# SRU PaperHub Environment Configuration
# Copy this file to .env and fill in your server-side secrets.
# NEVER commit .env or put GEMINI_API_KEY in frontend JS/HTML/Git.

PORT=3000
ADMIN_PASSWORD=change_this_to_a_secure_admin_password

# Google Gemini API (Server-side only — get yours from https://aistudio.google.com/apikey)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash

# AI Examiner Tuning & Guardrails (Optional overrides)
EXAMINER_TIMEOUT_SECONDS=45
EXAMINER_MAX_RETRIES=2
EXAMINER_MAX_UPLOAD_MB=15
EXAMINER_MAX_PDF_PAGES=8
EXAMINER_APPROVE_THRESHOLD=0.75
EXAMINER_REJECT_THRESHOLD=0.40
EXAMINER_RATE_LIMIT_PER_MIN=15
SRU_REFERENCE_PROFILES_DIR=server/references
