# SR University PaperHub - Environment Configuration
# Copy this file to .env and configure your production credentials.
# NOTE: Never commit your actual .env file or API keys to GitHub!

# HTTP Server Port
PORT=3000

# Administrator & Faculty Access Password
ADMIN_PASSWORD=change_this_to_a_secure_admin_password

# Google Gemini API Key for Multimodal Document Verification
# Get your API key from Google AI Studio: https://aistudio.google.com/
GEMINI_API_KEY=

# Gemini Model Selection (e.g. gemini-2.5-flash or gemini-3.8-flash)
GEMINI_MODEL=gemini-2.5-flash
